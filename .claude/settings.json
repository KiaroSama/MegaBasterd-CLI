{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "name": "sync-graphs",
            "command": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\sync-graphs.ps1\"\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
